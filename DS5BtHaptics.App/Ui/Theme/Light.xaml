<!--
    Light palette, same keys as Dark.xaml. Not simply inverted: on light backgrounds cards sit
    above the window colour (white on grey), on dark it is the other way round.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ══ Accent ══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="AccentBrush" Color="#4A44D6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#3A34C0" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#264A44D6" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

    <!-- ══ Text ════════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4A4A4A" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6E6E6E" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#A0A0A0" />

    <!-- ══ Surfaces ════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="WindowBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBrush" Color="#E6E6E6" />
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#D6D6D6" />
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#C8C8C8" />
    <SolidColorBrush x:Key="ControlDisabledBrush" Color="#F7F7F7" />

    <!-- ══ Strokes ═════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="StrokeBrush" Color="#B5B5B5" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E5E5E5" />
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="#C4C4C4" />

    <!-- ══ States ══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="ErrorBrush" Color="#C42B1C" />

</ResourceDictionary>
